# AssisList — compose environment (gitignored; copy to .env and fill in)
#
# Two secrets are REQUIRED. Compose refuses to start without them. Generate
# each with:  openssl rand -hex 32
TODO_API_TOKEN=change-me-generate-with-openssl-rand-hex-32
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-32

# Optional agent-scoped token (restricted writes). Unset = single-token mode.
# Must differ from TODO_API_TOKEN.
TODO_AGENT_TOKEN=
# Optional DeepSeek key — AI-enriched recommendation reasons
DEEPSEEK_API_KEY=

# Postgres (defaults fine for a fresh install)
POSTGRES_USER=assislist
POSTGRES_DB=assislist

# Host port for the web UI + API
PORT=3456
# Interface to publish on. Leave 0.0.0.0 unless something else already holds
# this port on another interface (e.g. a Tailscale proxy on <vpn-ip>:3456),
# which would make the 0.0.0.0 bind fail; then name one address, e.g.
# BIND_ADDR=192.168.1.180
BIND_ADDR=0.0.0.0
# Pin an image version (defaults to latest)
ASSISLIST_VERSION=latest

# Behind a reverse proxy? Set to the number of proxies (usually 1) so rate
# limiting sees real client IPs. Default 0 = trust no forwarded headers.
TRUST_PROXY=0
# error | warn | info | debug
LOG_LEVEL=info

# Browser session lifetime in seconds (default 30 days).
SESSION_TTL_SECONDS=2592000
# Send HSTS. Leave false unless this origin is HTTPS-only; normally the
# reverse proxy that terminates TLS should own this header.
ENABLE_HSTS=false
# Rate limits.
RATE_LIMIT_PER_MINUTE=300
LOGIN_ATTEMPTS_PER_15MIN=10
