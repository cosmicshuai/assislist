# AssisList client — environment (gitignored; copy to .env)
#
# There is no token here, deliberately. The client ships with no credential:
# you unlock the UI once by entering TODO_API_TOKEN and the server returns an
# httpOnly session cookie. Nothing secret is ever built into the bundle.
#
# API base — same-origin in production (Express serves /api/v1 on the same
# port). In dev the Vite proxy forwards /api to 127.0.0.1:3456.
VITE_API_BASE=/api/v1
