# AssisList client — environment (gitignored; copy to .env and fill in)
# NOTE: this token is embedded in the built web bundle and visible to anyone
# who can load the page. Use the same value as the server's TODO_API_TOKEN
# (user scope). For a single-user, own-network deployment this is fine — see
# SECURITY.md for the trust model.
VITE_TODO_API_TOKEN=change-me-same-as-server-TODO_API_TOKEN
# API base — same-origin in production (Express serves /api/v1)
VITE_API_BASE=/api/v1
