# AssisList server — environment (gitignored; copy to .env and fill in)
# PostgreSQL (Docker Compose defaults; adjust for your own Postgres)
DATABASE_URL=postgres://assislist:assislist@localhost:5432/assislist
# API Bearer token — used by capture skills, and entered once in the browser to
# unlock the UI. It is never shipped to the client. Generate with:
#   openssl rand -hex 32
TODO_API_TOKEN=change-me-generate-with-openssl-rand-hex-32
# Optional: agent-scoped token (restricted writes). Unset = single-token mode.
# Must differ from TODO_API_TOKEN.
TODO_AGENT_TOKEN=
# Optional: DeepSeek API key — enables AI-enriched recommendation reasons
DEEPSEEK_API_KEY=
# Bind
PORT=3456
HOST=0.0.0.0
# Run drizzle migrations at startup (default true). The server exits non-zero
# if a migration fails, so the container restarts rather than serving 500s.
AUTO_MIGRATE=true

# --- Optional hardening / ops ---
# Browser session lifetime in seconds (default 30 days).
SESSION_TTL_SECONDS=2592000
# Number of reverse proxies in front of the app (default 0 = trust none).
# Set to 1 behind nginx/Caddy/Traefik so rate limiting sees the real client IP.
TRUST_PROXY=0
# Send HSTS. Leave false unless this origin is HTTPS-only; normally the
# reverse proxy that terminates TLS should own this header.
ENABLE_HSTS=false
# Rate limits.
RATE_LIMIT_PER_MINUTE=300
LOGIN_ATTEMPTS_PER_15MIN=10
# error | warn | info | debug
LOG_LEVEL=info
