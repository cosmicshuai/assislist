# AssisList server — environment (gitignored; copy to .env and fill in)
# PostgreSQL (Docker Compose defaults; adjust for your own Postgres)
DATABASE_URL=postgres://assislist:assislist@localhost:5432/assislist
# API Bearer token shared with the web UI and capture skills — generate with:
#   openssl rand -hex 32
TODO_API_TOKEN=change-me-generate-with-openssl-rand-hex-32
# Optional: agent-scoped token (restricted writes). Unset = single-token mode.
TODO_AGENT_TOKEN=
# Optional: DeepSeek API key — enables AI-enriched recommendation reasons
DEEPSEEK_API_KEY=
# Bind
PORT=3456
HOST=0.0.0.0
# Run drizzle migrations at startup (default true)
AUTO_MIGRATE=true
